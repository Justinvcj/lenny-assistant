# ==============================================================================
# Lenny Growth Assistant - Environment Configuration
# ==============================================================================

# LLM & Embeddings (Ollama runs natively on the host machine by default)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://host.docker.internal:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# Optional: Cloud provider (Anthropic) - leave empty if using local Ollama
ANTHROPIC_API_KEY=

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql+psycopg://postgres:localdev@db:5432/lenny_assistant

# RAG & Agent Settings
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.62
HISTORY_TURNS=6
AGENT_TIMEOUT_S=120
ARTIFACT_TIMEOUT_S=90
ESSAY_TIMEOUT_S=420
ARTIFACT_MAX_BYTES=200000

# CORS & Server
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DATA_DIR=/data
LOG_LEVEL=INFO

# Host Port Configuration (custom host port bindings)
BACKEND_PORT=8000
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8000
# Note: PostgreSQL is not published to the host by default to prevent port conflicts.
